{
  "cases": [
    {
      "id": "claim_chapter_reward_success",
      "action_type": "claim_chapter_reward",
      "case_type": "success",
      "expected_deltas": [
        {
          "path": "progress.chapter_claimable",
          "before": true,
          "expected_after": false
        }
      ],
      "before_state": {
        "progress": {
          "chapter_claimable": true
        }
      },
      "after_state": {
        "progress": {
          "chapter_claimable": false
        }
      },
      "expected_status": "verified",
      "reason_contains": "all expected state deltas matched"
    },
    {
      "id": "claim_chapter_reward_popup_interrupt",
      "action_type": "claim_chapter_reward",
      "case_type": "popup_interrupt",
      "expected_deltas": [
        {
          "path": "progress.chapter_claimable",
          "before": true,
          "expected_after": false
        }
      ],
      "before_state": {
        "progress": {
          "chapter_claimable": true
        }
      },
      "after_state": {
        "global_state": {
          "popup": {
            "visible": true,
            "blocking": true
          }
        },
        "progress": {
          "chapter_claimable": true
        }
      },
      "expected_status": "failed",
      "reason_contains": "expected progress.chapter_claimable"
    },
