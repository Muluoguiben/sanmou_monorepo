{
  "cases": [
    {
      "id": "claim_chapter_reward_success",
      "action_type": "claim_chapter_reward",
      "case_type": "success",
      "expected_deltas": [
        {"path": "progress.current_chapter_id", "before": 17, "expected_after": 17},
        {"path": "progress.chapter_claimable", "before": true, "expected_after": false}
      ],
      "before_state": {"progress": {"current_chapter_id": 17, "chapter_claimable": true}},
      "after_state": {"progress": {"current_chapter_id": 17, "chapter_claimable": false}},
      "expected_status": "verified"
    },
    {
      "id": "claim_chapter_reward_popup_interrupt",
      "action_type": "claim_chapter_reward",
      "case_type": "popup_interrupt",
      "expected_deltas": [
        {"path": "progress.current_chapter_id", "before": 17, "expected_after": 17},
        {"path": "progress.chapter_claimable", "before": true, "expected_after": false}
      ],
      "before_state": {"progress": {"current_chapter_id": 17, "chapter_claimable": true}},
      "after_state": {
        "global_state": {"popup": {"visible": true, "blocking": true}},
        "progress": {"current_chapter_id": 17, "chapter_claimable": true}
      },
      "expected_status": "failed",
      "reason_contains": "progress.chapter_claimable"
    },
    {
      "id": "claim_chapter_reward_wrong_chapter",
      "action_type": "claim_chapter_reward",
      "case_type": "misrecognition",
      "expected_deltas": [
        {"path": "progress.current_chapter_id", "before": 17, "expected_after": 17},
        {"path": "progress.chapter_claimable", "before": true, "expected_after": false}
      ],
      "before_state": {"progress": {"current_chapter_id": 17, "chapter_claimable": true}},
      "after_state": {"progress": {"current_chapter_id": 18, "chapter_claimable": false}},
      "expected_status": "failed",
      "reason_contains": "current_chapter_id"
    },
